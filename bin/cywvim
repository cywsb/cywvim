#!/usr/bin/env bash

# ==================================================
# CywVim
# Command Line Interface
# ==================================================

set -euo pipefail

readonly ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

readonly COMMAND="${1:-help}"

shift || true

case "$COMMAND" in

    install|update|check|uninstall|version)

        exec "$ROOT/scripts/commands/${COMMAND}.sh" "$@"

        ;;

    help|-h|--help)

        exec "$ROOT/scripts/commands/help.sh" "$@"

        ;;

    *)

        echo
        echo "Comando desconocido: $COMMAND"
        echo

        exec "$ROOT/scripts/commands/help.sh"

        ;;

esac
